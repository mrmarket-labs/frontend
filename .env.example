# Required: powers the advisor (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: higher rate limits / reliability than the free public endpoints
COINGECKO_API_KEY=
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
HYPEREVM_RPC_URL=

# Optional: max advisor runs per visitor IP per hour (default 10)
ADVICE_PER_HOUR=

# Swap execution: fee collection addresses, fee size, aggregator keys
FEE_WALLET_SOLANA=
FEE_WALLET_EVM=
SWAP_FEE_BPS=50
# Required for Ethereum/L2 swaps (free key at dashboard.0x.org)
ZEROX_API_KEY=
# Optional: higher Jupiter rate limits
JUPITER_API_KEY=
