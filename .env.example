# Required: powers the advisor (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: higher rate limits / reliability than the free public endpoints
COINGECKO_API_KEY=
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
HYPEREVM_RPC_URL=

# Optional: max advisor runs per visitor IP per hour (default 10)
ADVICE_PER_HOUR=

# Swap execution: fee collection addresses, fee size, aggregator keys
FEE_WALLET_SOLANA=
FEE_WALLET_EVM=
SWAP_FEE_BPS=50
# Required for Ethereum/L2 swaps (free key at dashboard.0x.org)
ZEROX_API_KEY=
# Optional: higher Jupiter rate limits
JUPITER_API_KEY=

# Abuse protection
# Random secret for session cookies: openssl rand -hex 32
AUTH_SECRET=
# Upstash Redis (Vercel marketplace → Upstash); without it limits are per-instance only
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hard daily ceiling on advisor runs (Claude spend), per-wallet and per-IP quotas
ADVICE_DAILY_CAP=300
ADVICE_PER_WALLET_DAY=10
# Minimum portfolio value for a wallet to sign in
MIN_SIGNIN_USD=25

# Signal alerts (web push): generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/notify/cron; Vercel sends it as a Bearer token
CRON_SECRET=
# Email alerts via Resend (optional until set)
RESEND_API_KEY=
NOTIFY_FROM="Diversify <alerts@yourdomain>"
SITE_URL=https://investlikebuffett.xyz
