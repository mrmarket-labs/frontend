# Required: the private advisor service (mrmarket-labs/advisor), which holds the prompt and the Claude key.
# The token must match its ADVISOR_API_TOKEN. Locally: http://localhost:3001 with `npm run dev` in that repo.
ADVISOR_URL=
ADVISOR_API_TOKEN=

# Optional: higher rate limits / reliability than the free public endpoints
COINGECKO_API_KEY=
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
HYPEREVM_RPC_URL=

# Optional: max advisor runs per visitor IP per hour (default 10)
ADVICE_PER_HOUR=

# Swap execution: fee collection addresses, fee size, aggregator keys
FEE_WALLET_SOLANA=
FEE_WALLET_EVM=
# Optional: collects the fee on Hyperliquid orders (builder fee). The address must hold 100+ USDC on Hyperliquid.
HYPERLIQUID_BUILDER=
SWAP_FEE_BPS=50
# Required for Ethereum/L2 swaps (free key at dashboard.0x.org)
ZEROX_API_KEY=
# Optional: higher Jupiter rate limits
JUPITER_API_KEY=

# Optional: WalletConnect (QR / phone wallets). Free project id at dashboard.reown.com; add this site's domain there.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: Google Analytics 4 measurement id (G-…); nothing loads without it
NEXT_PUBLIC_GA_ID=

# Abuse protection
# Random secret for session cookies: openssl rand -hex 32
AUTH_SECRET=
# Upstash Redis (Vercel marketplace → Upstash); without it limits are per-instance only
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Hard daily ceiling on advisor runs (Claude spend), per-wallet and per-IP quotas
ADVICE_DAILY_CAP=300
ADVICE_PER_WALLET_DAY=10
# Test analyses a wallet gets in total (default 3); failed runs are given back
ADVICE_PER_WALLET_TOTAL=3
# Minimum portfolio value for a wallet to sign in
MIN_SIGNIN_USD=25

# Signal alerts (web push): generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/notify/cron; Vercel sends it as a Bearer token
CRON_SECRET=
# Email alerts via Resend (optional until set)
RESEND_API_KEY=
NOTIFY_FROM="Diversify <alerts@yourdomain>"
SITE_URL=https://investlikebuffett.xyz

# PACFI v1.0 from mrmarket-labs/indicators, served at /api/pacfi; the token must match its PACFI_API_TOKEN
INDICATORS_URL=https://indicators-umber.vercel.app
INDICATORS_API_TOKEN=

# Waitlist submissions: private Vercel Blob store `waitlist` (Storage → connect to the project)
BLOB_READ_WRITE_TOKEN=
